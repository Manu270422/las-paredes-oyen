{
  "name": "las-paredes-oyen",
  "version": "0.1.0",
  "description": "Las Paredes Oyen — videojuego de terror psicológico construido sin motor comercial (TypeScript + WebGL2 + Web Audio).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck:tests && npm run test:unit && npm run test:e2e",
    "typecheck:tests": "tsc -p pruebas/tsconfig.json",
    "test:unit": "vitest run --config pruebas/vitest.config.ts",
    "test:e2e": "playwright test --config pruebas/playwright.config.ts"
  },
  "keywords": [
    "terror",
    "horror",
    "webgl",
    "webaudio",
    "juego"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
